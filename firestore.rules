rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }
    function isGoogleAuth() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /utenti/{uid} {
      allow read: if true;
      allow write: if isGoogleAuth();
    }

    match /eventi/{eventId} {
      allow read: if true;
      allow write: if isAuth() && eventId.matches('evt_[0-9]+');

      match /partecipanti/{partId} {
        allow read: if true;
        allow create: if true;
        allow update: if isAuth() || partId.matches('P[0-9]+');
        allow delete: if false;
      }

      match /logs/{logId} {
        allow read: if isAuth();
        allow create: if isAuth()
          && request.resource.data.keys().hasAll(['partecipanteId','tipo','ora','tsISO','nome'])
          && request.resource.data.tipo in ['entrata','uscita'];
        allow update: if false;
        allow delete: if false;
      }

      match /sessioni/{sessId} {
        allow read: if true;
        allow write: if isAuth();

        // Check-in per sessione congress
        match /checkin/{partId} {
          allow read: if true;
          allow write: if isAuth();
        }
      }

      match /relatori/{relId} {
        allow read: if true;
        allow write: if isAuth();
      }

      match /sale/{salaId} {
        allow read: if true;
        allow write: if isAuth();
      }

      // Certificati emessi
      match /certificati/{certId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }

      match /survey/config {
        allow read: if true;
        allow write: if isAuth();
      }
      match /survey/risposte/lista/{rId} {
        allow read: if isAuth();
        allow create: if true;
        allow update: if false;
        allow delete: if false;
      }

      match /questionario/config {
        allow read: if true;
        allow write: if isAuth();
      }
      match /questionario/risposte/lista/{rId} {
        allow read: if isAuth();
        allow create: if true;
        allow update: if false;
        allow delete: if false;
      }

      // Wildcard per qualsiasi altra sub-collection
      match /{subCol}/{docId} {
        allow read: if true;
        allow write: if isAuth();

        match /{nestedCol}/{nestedId} {
          allow read: if true;
          allow write: if isAuth();
        }
      }
    }
  }
}
