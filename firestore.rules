rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // Utenti operatori — leggibili anche senza Google Auth
    // (il login operatori avviene lato client con hash password)
    match /utenti/{uid} {
      allow read: if true;  // necessario per il login operatori
      allow write: if isAuth(); // solo admin Google può creare/modificare
    }

    match /eventi/{eventId} {
      allow read:  if isAuth();
      allow write: if isAuth() && eventId.matches('evt_[0-9]+');

      match /partecipanti/{partId} {
        allow read:   if isAuth();
        allow create: if isAuth() && partId.matches('P[0-9]+');
        allow update: if isAuth() && partId.matches('P[0-9]+');
        allow delete: if false;
      }

      match /logs/{logId} {
        allow read: if isAuth();
        allow create: if isAuth()
          && request.resource.data.keys().hasAll([
               'partecipanteId','tipo','ora','tsISO','nome'
             ])
          && request.resource.data.tipo in ['entrata','uscita'];
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
