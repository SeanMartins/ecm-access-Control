rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // ── ACCESSO APERTO PER SVILUPPO/TESTING ──
    // Permette lettura/scrittura a tutti gli utenti autenticati
    // (incluso signInAnonymously)
    // NOTA: restringere dopo il go-live

    match /{document=**} {
      allow read: if true;
      allow write: if isAuth();
    }
  }
}
